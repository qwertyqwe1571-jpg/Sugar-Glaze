PORT=3100
NODE_ENV=development
APP_URL=http://localhost:3100
CORS_ORIGIN=http://localhost:3100
SESSION_COOKIE_NAME=sg_session

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional: server-only Supabase Management API token.
# If token is set, backend can call POST /v1/projects/{ref}/restore when the free project is paused
# and GET /v1/projects/{ref}/health to show per-service startup states in the storefront modal.
# Project ref can be omitted when SUPABASE_URL is a standard https://<ref>.supabase.co URL.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_MANAGEMENT_TOKEN=your_management_api_token
# Optional: kept only for reference; the server does not fall back to anon access.
SUPABASE_ANON_KEY=your_anon_key

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Recommended on Render Free: Brevo Transactional Email API uses HTTPS, not SMTP.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified_sender@example.com
BREVO_SENDER_NAME=Sugar & Glaze

# Optional local fallback. Render Free blocks outbound SMTP ports, so prefer Brevo there.
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
ORDER_NOTIFICATIONS_EMAIL=orders@sugarglaze.example
